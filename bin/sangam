    "pr": {"type": "string", "description": "owner/repo#number or the PR's URL."},
    "account": {"type": "string", "description": "A gh account to read it as. Default: the first that can see it."}}}},
 {"name": "pr_diff", "annotations": {"readOnlyHint": true},
  "description": "A PR's diff (unified), optionally of one file. Long diffs are cut at max_lines; ask for one file at a time then.",
  "inputSchema": {"type": "object", "required": ["pr"], "properties": {
    "pr": {"type": "string", "description": "owner/repo#number or the PR's URL."},
    "file": {"type": "string", "description": "Only this file's diff (its path, or the end of it)."},
    "max_lines": {"type": "integer", "description": "Default 2000."},
    "account": {"type": "string"}}}},
 {"name": "pr_comment",
  "description": "Post a comment on a PR (markdown). Waits for the user's approval in a popup; they may edit the text or decline. Reports posted or declined.",
  "inputSchema": {"type": "object", "required": ["pr", "body"], "properties": {
    "pr": {"type": "string"}, "body": {"type": "string"},
    "account": {"type": "string", "description": "The gh account to post as. Default: the first that can see the PR."}}}},
 {"name": "pr_review",
  "description": "Submit a review: approve (body optional), request_changes or comment (body needed). Waits for the user's approval in a popup; they may edit the text or decline.",
  "inputSchema": {"type": "object", "required": ["pr", "event"], "properties": {
    "pr": {"type": "string"},
    "event": {"type": "string", "enum": ["approve", "request_changes", "comment"]},
    "body": {"type": "string"},
    "account": {"type": "string"}}}},
 {"name": "pr_merge", "annotations": {"destructiveHint": true},
  "description": "Merge a PR, or turn on auto-merge (auto: merges once checks and reviews pass). Waits for the user's approval in a popup, which shows the PR's checks and review state.",
  "inputSchema": {"type": "object", "required": ["pr"], "properties": {
    "pr": {"type": "string"},
    "method": {"type": "string", "enum": ["squash", "merge", "rebase"], "description": "Default squash."},
    "auto": {"type": "boolean", "description": "Enable auto-merge instead of merging now."},
    "delete_branch": {"type": "boolean", "description": "Delete the PR's branch on GitHub after merging."},
    "account": {"type": "string"}}}}
]
EOF
)

signed_in() { gh auth status 2>&1 | sed -n 's/.*Logged in to github.com account \([^ ]*\).*/\1/p'; }
gh_active() { gh config get user -h github.com 2>/dev/null; }

# The account sangam shows, and the tmux bar counts: the one picked with u
# (if still signed in; empty there means all accounts), else gh's active
# one. Prints nothing for all accounts.
picked_account() {
  local p
  if [ -f "$CROOT/last-account" ]; then
    p=$(<"$CROOT/last-account")
    [ -n "$p" ] && signed_in | grep -qixF "$p" && echo "$p"
    return 0
  fi
  gh_active
}

# accounts_for <account arg>: the accounts to search, one per line.
accounts_for() {
  local all; all=$(signed_in)
  [ -n "$all" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  case ${1,,} in
    all) echo "$all" ;;
    "") local p; p=$(picked_account); if [ -n "$p" ]; then echo "$p"; else echo "$all"; fi ;;
    *) grep -ixF "$1" <<<"$all" || { echo "$1 isn't signed in to gh (signed in: $(paste -sd' ' <<<"$all"))"; return 1; } ;;
  esac
}

arg() { jq -r --arg k "$1" '.[$k] // empty | tostring' <<<"$ARGS"; }

# parse_pr <owner/repo#N | URL>: sets REPO and N.
parse_pr() {
  if [[ $1 =~ github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || [[ $1 =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then
    REPO=${BASH_REMATCH[1]} N=${BASH_REMATCH[2]}
  else
    echo "pr must be owner/repo#number or a pull request URL, not \"$1\""; return 1
  fi
}

# use_account <account arg>: acts as the account asked for, else the first of
# sangam's pick, gh's active one and the rest that can see REPO#N. Sets ACCT
# and exports its GH_TOKEN.
use_account() {
  local a t cands
  if [ -n "$1" ] && [ "${1,,}" != all ]; then cands=$(accounts_for "$1") || { echo "$cands"; return 1; }
  else cands=$({ picked_account; gh_active; signed_in; } | awk 'NF && !seen[tolower($0)]++'); fi
  [ -n "$cands" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  for a in $cands; do
    t=$(token "$a") || continue
    if GH_TOKEN=$t timeout 30 gh api "repos/$REPO/pulls/$N" --jq .number >/dev/null 2>&1; then
      ACCT=$a; export GH_TOKEN=$t; return 0
    fi
  done
  echo "$REPO#$N wasn't found, or none of these accounts can see it: $(paste -sd' ' <<<"$cands")"; return 1
}

search_count() {  # search_count <account> <query>
  GH_TOKEN=$(token "$1") timeout 30 gh api -X GET search/issues -f q="$2" -f per_page=1 --jq .total_count
}

tool_pr_accounts() {
  local all; all=$(signed_in)
  [ -n "$all" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  echo "Signed in: $(paste -sd' ' <<<"$all")"
  echo "gh's active account: $(gh_active)"
  if [ -f "$CROOT/last-account" ]; then echo "Picked in sangam (the default here, and what the tmux bar counts): $(picked_account | grep . || echo 'all accounts')"
  else echo "Nothing picked in sangam: the default here (and the tmux bar) is gh's active account"; fi
}

tool_pr_counts() {
  local accts a n p tn=0 tp=0 k=0
  accts=$(accounts_for "$(arg account)") || { echo "$accts"; return 1; }
  for a in $accts; do
    n=$(search_count "$a" 'is:pr is:open archived:false review-requested:@me') || { echo "$a: GitHub didn't answer (offline?)"; return 1; }
    p=$(search_count "$a" 'is:pr is:open archived:false author:@me') || { echo "$a: GitHub didn't answer (offline?)"; return 1; }
    echo "$a: $n waiting for your review, $p of your own open"
    tn=$((tn + n)) tp=$((tp + p)) k=$((k + 1))
  done
  ((k > 1)) && echo "all: $tn waiting for your review, $tp of your own open"
  return 0
}

# One search as one account: a line per PR.
agent_search() {  # agent_search <account> <query> <state> <limit>
  local st out
  case $3 in merged) st=is:merged ;; closed) st='is:closed is:unmerged' ;; all) st= ;; *) st=is:open ;; esac
  out=$(GH_TOKEN=$(token "$1") timeout 60 gh api graphql -f query="$SEARCH" -f q="is:pr archived:false $2 $st sort:updated-desc" \
    --jq '[.data.search.nodes[] | select(.number)]' 2>&1) || { echo "  (GitHub said: ${out:0:300})"; return 1; }
  jq -r --argjson lim "$4" "$JQ_DEFS"'
    if length == 0 then "  (none)" else
    (.[:$lim][] | "  \(.repository.nameWithOwner)#\(.number)  \(.title)\n      by \(.author.login // "ghost") · \(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end) · updated \(ago(.updatedAt)) ago · +\(.additions) −\(.deletions) · checks \((.commits.nodes[0].commit.statusCheckRollup.state // "none") | ascii_downcase) · review \((.reviewDecision // "none") | ascii_downcase)"),
    (if length > $lim then "  (\(length - $lim) more not shown; raise limit or narrow the search)" elif length == 50 then "  (maybe more: narrow the search)" else empty end) end' <<<"$out"
}

tool_pr_list() {
  local q sec st lim accts a name sa sq found=0
  q=$(arg query) sec=$(arg section) st=$(arg state) lim=$(arg limit)
  case ${st:-open} in open | merged | closed | all) ;; *) echo "state is open, merged, closed or all"; return 1 ;; esac
  accts=$(accounts_for "$(arg account)") || { echo "$accts"; return 1; }
  q=$(sed -E 's/(^| )is:pr( |$)/ /g' <<<"$q")
  echo "<untrusted>"
  if [ -n "$q" ] && [ -z "$sec" ]; then
    lim=${lim:-30}
    for a in $accts; do echo "As $a, \"$q\" (${st:-open}):"; agent_search "$a" "$q" "$st" "$(clamp "$lim")"; done
  else
    [ -f "$CONFIG" ] || default_config
    lim=${lim:-$([ -n "$sec" ] && echo 30 || echo 10)}
    while IFS=$'\t' read -r name sa sq; do
      [ -n "$sec" ] && [[ ${name,,} != "${sec,,}"* ]] && continue
      found=1
      [ -n "$q" ] && sq+=" $q"
      for a in $accts; do
        [ -n "$sa" ] && [ "${sa,,}" != "${a,,}" ] && continue
        echo "$name, as $a (${st:-open}):"; agent_search "$a" "$sq" "$st" "$(clamp "$lim")"
      done
    done < <(sed -e 's/#.*//' "$CONFIG" | awk -F'|' 'NF >= 3 { for (i = 1; i <= 3; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i); if ($1 != "") print $1 "\t" $2 "\t" $3 }')
  fi
  echo "</untrusted>"
  if [ -n "$sec" ] && ((!found)); then
    echo "No section \"$sec\". Sections: $(sed -e 's/#.*//' "$CONFIG" | awk -F'|' 'NF >= 3 { gsub(/^[ \t]+|[ \t]+$/, "", $1); if ($1 != "" && !seen[$1]++) printf "%s; ", $1 }')"; return 1
  fi
  return 0
}
clamp() { local n=${1//[^0-9]/}; n=${n:-30}; ((n < 1)) && n=1; ((n > 50)) && n=50; echo "$n"; }

tool_pr_view() {
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local j rc
  j=$(timeout 60 gh pr view "$N" -R "$REPO" --json "$VIEW_FIELDS" 2>&1) || { echo "gh pr view: ${j:0:300}"; return 1; }
  rc=$(timeout 60 gh api "repos/$REPO/pulls/$N/comments" --paginate 2>/dev/null | jq -s 'add // []' 2>/dev/null) || rc='[]'
  jq -r --arg acct "$ACCT" --arg repo "$REPO" --argjson rc "${rc:-[]}" "$JQ_DEFS"'
    "\($repo)#\(.number): \(.title)", .url, "(read as \($acct))", "",
    "State: \(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end) · by \(.author.login) · \(.headRefName) → \(.baseRefName)\(if .isCrossRepository then " (from a fork)" else "" end)",
    "Created \(ago(.createdAt)) ago, updated \(ago(.updatedAt)) ago\(if .mergedAt then ", merged \(ago(.mergedAt)) ago" elif .closedAt then ", closed \(ago(.closedAt)) ago" else "" end)",
    "Mergeable: \(.mergeable | ascii_downcase) (\(.mergeStateStatus | ascii_downcase)) · review: \((.reviewDecision // "none") | ascii_downcase) · checks: \(ci)",
    "+\(.additions) −\(.deletions) in \(.changedFiles) files",
    (if (.labels | length) > 0 then "Labels: \([.labels[].name] | join(", "))" else empty end),
    (if (.assignees | length) > 0 then "Assignees: \([.assignees[].login] | join(", "))" else empty end),
    (if (.reviewRequests | length) > 0 then "Review requested from: \([.reviewRequests[] | .login // .name // .slug] | join(", "))" else empty end),
    (if (.latestReviews | length) > 0 then "Reviews: \([.latestReviews[] | "\(.author.login) \(.state | ascii_downcase)"] | join(", "))" else empty end),
    (if (.statusCheckRollup | length) > 0 then "", "Checks:",
      (.statusCheckRollup[] | "  \(.name // .context): \((.conclusion // .state // .status // "?") | ascii_downcase)\(if ((.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE")) then "  \(.detailsUrl // .targetUrl // "")" else "" end)") else empty end),
    "", "Files:", (.files[:150][] | "  \(.path)  +\(.additions) −\(.deletions)"),
    (if (.files | length) > 150 then "  (\(.files | length) files; first 150 shown)" else empty end),
    "", "<untrusted>", "Description:", (if (.body // "") == "" then "(none)" else .body end),
    (if (.comments | length) > 0 then "", "Comments (\(.comments | length), last 25 shown):",
      (.comments[-25:][] | "--- \(.author.login), \(ago(.createdAt)) ago:", .body) else empty end),
    (if (.reviews | map(select((.body // "") != "")) | length) > 0 then "", "Review summaries:",
      (.reviews | map(select((.body // "") != ""))[-15:][] | "--- \(.author.login) (\(.state | ascii_downcase)):", .body) else empty end),
    (if ($rc | length) > 0 then "", "Inline review comments (\($rc | length), last 40 shown):",
      ($rc[-40:][] | "--- \(.user.login) on \(.path):\(.line // .original_line // "?"):", .body) else empty end),
    "</untrusted>"' <<<"$j"
}

tool_pr_diff() {
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local d f max total
  f=$(arg file) max=$(arg max_lines); max=${max//[^0-9]/}; max=${max:-2000}
  d=$(timeout 90 gh pr diff "$N" -R "$REPO" --color=never 2>&1) || { echo "gh pr diff: ${d:0:300}"; return 1; }
  if [ -n "$f" ]; then
    d=$(awk -v f="$f" '/^diff --git / { p = $4; sub(/^b\//, "", p); on = (p == f || substr(p, length(p) - length(f) + 1) == f) } on' <<<"$d")
    [ -n "$d" ] || { echo "$REPO#$N doesn't change a file \"$f\" (pr_view lists its files)"; return 1; }
  fi
  total=$(wc -l <<<"$d")
  echo "<untrusted>"
  head -n "$max" <<<"$d"
  echo "</untrusted>"
  ((total > max)) && echo "($((total - max)) more lines cut; ask for one file with file=, or a larger max_lines)"
  return 0
}

# ask_approval <what> <details> [<text>]: asks the user. 0 yes (the text,
# maybe edited, in $ASKED_TEXT), 1 no or no answer in time, 2 no way to ask.
ask_approval() {
  local d shown=0 i c
  d=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/sangam-ask.XXXXXX") || return 2
  printf '%s' "$1" >"$d/what"; printf '%s\n' "$2" >"$d/details"
  [ $# -ge 3 ] && printf '%s' "$3" >"$d/text"
  # A tmux popup: on the agent's own pane when it runs in tmux, else on the
  # tmux client used last.
  if command -v tmux >/dev/null && tmux list-clients >/dev/null 2>&1; then
    local target=()
    if [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ]; then target=(-t "$TMUX_PANE")
    else
      c=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
      [ -n "$c" ] && target=(-c "$c")
    fi
    if [ ${#target[@]} -gt 0 ] && tmux display-popup "${target[@]}" -E -w 84% -h 80% -b rounded -S "fg=$HI" \
        -T "#[fg=$HI] sangam: an agent asks #[fg=$DIMH]· y approve · n decline · e edit " \
        "SANGAM_ASK='$d' '$self' --approve-ui" 2>/dev/null; then
      shown=1
      command -v notify-send >/dev/null && notify-send -a sangam ${ICON:+-i "$ICON"} "An agent asks: $1" "Answer in the tmux popup." 2>/dev/null &
    fi
  fi
  # No tmux: a notification with Approve / Decline buttons (no editing).
  if ((!shown)) && command -v notify-send >/dev/null; then
    ( a=$(timeout "$ASK_TIMEOUT" notify-send -a sangam ${ICON:+-i "$ICON"} -u critical -t 0 --wait \
          -A yes=Approve -A no=Decline "An agent asks: $1" "$(head -c 600 "$d/details"; [ -f "$d/text" ] && { echo; head -c 600 "$d/text"; })" 2>/dev/null)
      [ -e "$d/answer" ] || echo "${a:-no}" >"$d/answer" ) &
    shown=1
  fi
  ((shown)) || { rm -rf "$d"; return 2; }
  for ((i = 0; i < ASK_TIMEOUT * 2; i++)); do [ -s "$d/answer" ] && break; sleep 0.5; done
  ASKED_TEXT=$(cat "$d/text" 2>/dev/null)
  local ans; ans=$(cat "$d/answer" 2>/dev/null)
  rm -rf "$d"
  [ "$ans" = yes ]
}

# --approve-ui: the popup's screen, for the request in $SANGAM_ASK.
approve_ui() {
  local d=$SANGAM_ASK k
  [ -d "$d" ] || exit 1
  trap '[ -s "$d/answer" ] || echo no >"$d/answer"' EXIT
  while :; do
    clear
    printf '\n  %s%sAn agent asks: %s%s\n\n' "$b" "$rose" "$(cat "$d/what")" "$r"
    sed 's/^/  /' "$d/details"
    if [ -f "$d/text" ]; then echo; rule "what it will say" | sed 's/^/  /'; md <"$d/text" | sed 's/^/  /'; fi
    printf '\n\n  %sy%s approve   %sn%s decline   %s%s\n' "$key" "$r" "$key" "$r" \
      "$([ -f "$d/text" ] && printf '%se%s edit the text   ' "$key" "$r")" "$dim(no answer in $((ASK_TIMEOUT / 60)) minutes is a no)$r"
    k=$(ask "")
    case $k in
      y | Y) echo yes >"$d/answer"; return ;;
      n | N | q | $'\e') echo no >"$d/answer"; return ;;
      e | E)  # an editor with arguments (code --wait) splits into words
        local ed; read -ra ed <<<"${VISUAL:-${EDITOR:-vi}}"
        [ -f "$d/text" ] && "${ed[@]}" "$d/text" </dev/tty >/dev/tty ;;
    esac
  done
}

# asked <what> <details> [<text>]: ask_approval, and the reply when it's not a yes.
asked() {
  ask_approval "$@"
  case $? in
    0) return 0 ;;
    2) echo "Nothing done: there's no tmux client or notification daemon to ask the user for approval."; return 1 ;;
    *) echo "Nothing done: the user declined (or didn't answer within $((ASK_TIMEOUT / 60)) minutes)."; return 1 ;;
  esac
}

pr_title() { timeout 30 gh pr view "$N" -R "$REPO" --json title,state,isDraft --jq '"\(.title)  (\(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end))"' 2>/dev/null; }

tool_pr_comment() {
  local body out; body=$(arg body)
  [ -n "$body" ] || { echo "body is empty"; return 1; }
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  asked "comment on $REPO#$N" "$(pr_title)"$'\n'"as $ACCT" "$body" || return 1
  [ -n "$ASKED_TEXT" ] || { echo "Nothing done: the user emptied the comment."; return 1; }
  out=$(timeout 60 gh pr comment "$N" -R "$REPO" --body-file - <<<"$ASKED_TEXT" 2>&1) || { echo "gh pr comment failed: $out"; return 1; }
  changed
  echo "Posted as $ACCT: $out"
  [ "$ASKED_TEXT" = "$body" ] || printf '\nThe user edited it before posting; what was posted:\n%s\n' "$ASKED_TEXT"
}

tool_pr_review() {
  local ev flag body out; ev=$(arg event) body=$(arg body)
  case $ev in
    approve) flag=--approve ;;
    request_changes) flag=--request-changes ;;
    comment) flag=--comment ;;
    *) echo "event is approve, request_changes or comment"; return 1 ;;
  esac
  [ "$ev" = approve ] || [ -n "$body" ] || { echo "$ev needs a body"; return 1; }
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  asked "${ev/_/ } on $REPO#$N" "$(pr_title)"$'\n'"as $ACCT" "$body" || return 1
  [ "$ev" = approve ] || [ -n "$ASKED_TEXT" ] || { echo "Nothing done: the user emptied the review."; return 1; }
  out=$(timeout 60 gh pr review "$N" -R "$REPO" "$flag" ${ASKED_TEXT:+--body-file -} <<<"$ASKED_TEXT" 2>&1) || { echo "gh pr review failed: $out"; return 1; }
  changed
  echo "Review submitted as $ACCT (${ev/_/ }) on $REPO#$N."
  [ "$ASKED_TEXT" = "$body" ] || printf '\nThe user edited it first; what was submitted:\n%s\n' "$ASKED_TEXT"
}

tool_pr_merge() {
  local how auto del out info
  how=$(arg method); how=${how:-squash} auto=$(arg auto) del=$(arg delete_branch)
  case $how in squash | merge | rebase) ;; *) echo "method is squash, merge or rebase"; return 1 ;; esac
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  info=$(timeout 30 gh pr view "$N" -R "$REPO" --json title,state,isDraft,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup,headRefName,baseRefName \
    --jq "$JQ_DEFS"'"\(.title)", "\(.headRefName) → \(.baseRefName) · \(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end)", "mergeable: \(.mergeable | ascii_downcase) (\(.mergeStateStatus | ascii_downcase)) · review: \((.reviewDecision // "none") | ascii_downcase) · checks: \(ci)"' 2>&1) \
    || { echo "gh pr view: ${info:0:300}"; return 1; }
  asked "$([ "$auto" = true ] && echo "turn on auto-merge ($how) for" || echo "$how-merge") $REPO#$N" \
    "$info"$'\n'"as $ACCT$([ "$del" = true ] && echo ", then delete the branch")" || return 1
  # From /: with --delete-branch, gh would also switch and delete branches
  # of a local clone it runs in.
  local flags=("--$how")
  [ "$auto" = true ] && flags+=(--auto)
  [ "$del" = true ] && flags+=(--delete-branch)
  out=$(cd / && timeout 120 gh pr merge "$N" -R "$REPO" "${flags[@]}" </dev/null 2>&1) || { echo "gh pr merge failed: $out"; return 1; }
  changed
  if [ "$auto" = true ]; then echo "Auto-merge ($how) is on for $REPO#$N: it merges once everything passes."
  else echo "Merged $REPO#$N ($how) as $ACCT.${out:+ $out}"; fi
}

run_tool() {  # run_tool <name>, with its arguments (a JSON object) in $ARGS
  case $1 in
    pr_accounts | pr_counts | pr_list | pr_view | pr_diff | pr_comment | pr_review | pr_merge) "tool_$1" ;;
    *) echo "unknown tool \"$1\" (sangam call lists them)"; return 1 ;;
  esac
}

# sangam call <tool> [json]: one tool, for agents without MCP. Exit 1 on error.
agent_call() {
  check_agent_deps || exit 1
  if [ -z "${1:-}" ]; then
    printf 'sangam call <tool> [json arguments]   e.g.  sangam call pr_view %s\n\n' "'{\"pr\":\"owner/repo#12\"}'"
    jq -r '.[] | "  \(.name)\n      \(.description)\n      arguments: \(.inputSchema.properties | keys | join(", ") | if . == "" then "none" else . end)"' <<<"$TOOLS_JSON"
    exit 0
  fi
  ARGS=${2:-'{}'}
  jq -e 'type == "object"' <<<"$ARGS" >/dev/null 2>&1 || die "the arguments must be a JSON object, like '{\"pr\":\"owner/repo#12\"}'"
  run_tool "$1"
}

check_agent_deps() {
  local c; for c in gh jq; do command -v "$c" >/dev/null || { echo "sangam: $c is needed (sangam doctor)" >&2; return 1; }; done
}

# sangam mcp: an MCP server (JSON-RPC, one message per line, on stdio).
# Each tool call runs in the background, so a call waiting for your
# approval doesn't hold up the others; replies are written one at a time.
mcp_server() {
  check_agent_deps || exit 1
  local line id method
  MCP_LOCK=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/sangam-mcp.XXXXXX") || exit 1
  trap 'rm -f "$MCP_LOCK"' EXIT
  reply() { { flock 9; printf '%s\n' "$1"; } 9>>"$MCP_LOCK"; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id=$(jq -c '.id // empty' <<<"$line" 2>/dev/null) method=$(jq -r '.method // empty' <<<"$line" 2>/dev/null)
    case $method in
      initialize)
        reply "$(jq -cn --argjson id "$id" --arg v "$(jq -r '.params.protocolVersion // "2025-06-18"' <<<"$line")" \
          --arg ver "$VERSION" --arg ins "$MCP_INSTRUCTIONS" \
          '{jsonrpc: "2.0", id: $id, result: {protocolVersion: $v, capabilities: {tools: {}},
            serverInfo: {name: "sangam", version: $ver}, instructions: $ins}}')" ;;
      ping) reply "$(jq -cn --argjson id "$id" '{jsonrpc: "2.0", id: $id, result: {}}')" ;;
      tools/list) reply "$(jq -cn --argjson id "$id" --argjson t "$TOOLS_JSON" '{jsonrpc: "2.0", id: $id, result: {tools: $t}}')" ;;
      tools/call)
        (
          ARGS=$(jq -c '.params.arguments // {}' <<<"$line") name=$(jq -r '.params.name' <<<"$line")
          err=$(mktemp) out=$(run_tool "$name" 2>"$err"); rc=$?
          ((rc)) && [ -s "$err" ] && out+=$'\n'$(tail -c 2000 "$err")
          rm -f "$err"
          reply "$(jq -cn --argjson id "$id" --arg t "$out" --argjson e "$([ $rc = 0 ] && echo false || echo true)" \
            '{jsonrpc: "2.0", id: $id, result: {content: [{type: "text", text: $t}], isError: $e}}')"
        ) & ;;
      *) [ -n "$id" ] && reply "$(jq -cn --argjson id "$id" --arg m "$method" '{jsonrpc: "2.0", id: $id, error: {code: -32601, message: ("no method " + $m)}}')" ;;
    esac
  done
  wait
}

# ------------------------------------------------------------------ main
case $1 in
  --list) list "$2"; exit ;;
  --reload) fetch_list; changed; list; exit ;;
  --preview) [ -n "$2" ] && { set_pr "$2" || exit; }; preview "$N"; exit ;;
  --plabel) preview_label "$2"; exit ;;
  --llabel) list_label "$2"; exit ;;
  --colhead) colhead; exit ;;
  --keys) keysheet; exit ;;
  --sections-menu) sections_menu; exit ;;
  --strip) strip; exit ;;
  --main) run_main; exit ;;
  --show-keys)
    tmux display-popup -E -w 116 -h 15 -b rounded -S "fg=$HI" -T "#[fg=$HI] keys #[fg=$DIMH]· any key closes " \
      "STATE='$STATE' '$self' --keys"; exit ;;
  --toggle-all)
    if [ "$(state)" = all ]; then echo open >"$STATE/state"; else echo all >"$STATE/state"; fi
    rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --next-acct)
    mapfile -t accts <"$STATE/accounts"
    cur=$(acct) nxt=""
    if [ -z "$cur" ]; then nxt=${accts[0]:-}
    else for i in "${!accts[@]}"; do [ "${accts[$i],,}" = "${cur,,}" ] && nxt=${accts[$((i + 1))]:-}; done; fi
    printf '%s' "$nxt" >"$STATE/acct"; printf '%s' "$nxt" >"$CROOT/last-account"; build_sections; echo 0 >"$STATE/sec"; rm -f "$STATE/fresh" "$STATE/query"
    setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --search)
    clear; printf '\n  %sSearch GitHub within %s%s%s\n  %se.g.  author:jiggy   label:bug   head:feat/x   "matchmaking"   (empty clears)%s\n\n  %s❯%s ' \
      "$dim" "$gold" "$(secf "$(sec)" 1)" "$r" "$dim" "$r" "$rose" "$r"
    read -re -i "$(query)" q || exit
    printf '%s' "$q" >"$STATE/query"; rm -f "$STATE/fresh"; exit ;;
  --mode) echo "$2" >"$STATE/mode"; exit ;;
  --next-mode)
    case $(mode) in overview) m='diff' ;; diff) m='checks' ;; checks) m='comments' ;; *) m='overview' ;; esac
    echo "$m" >"$STATE/mode"; exit ;;
  --next-state)
    cur=$(state) nxt=${STATES[0]}
    for i in "${!STATES[@]}"; do [ "${STATES[$i]}" = "$cur" ] && nxt=${STATES[$(( (i + 1) % ${#STATES[@]} ))]}; done
    echo "$nxt" >"$STATE/state"; rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --section)
    echo $(( ($(sec) + $2 + $(nsec)) % $(nsec) )) >"$STATE/sec"; rm -f "$STATE/fresh"
    secf "$(sec)" 1 >"$CROOT/last-section"; exit ;;
  --edit)
    [ -f "$CONFIG" ] || default_config
    "${VISUAL:-${EDITOR:-vi}}" "$CONFIG" </dev/tty >/dev/tty
    build_sections; rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --fetch-all) fetch_all; exit ;;
  --fetch-pr) set_pr "$2" && fetch_pr "$N"; exit ;;
  # First load shows the cached list; it then asks for the fresh one once.
  # Every load updates the tabs and prefetches details in the background.
  --on-load)
    if [ ! -e "$STATE/fresh" ]; then
      touch "$STATE/fresh"; echo "change-list-label($(list_label refreshing…))+reload-sync($self --reload)"; exit
    fi
    setsid -f "$self" --prefetch >/dev/null 2>&1
    echo "change-list-label($(list_label))"; exit ;;
  --copy)
    set_pr "$2" && jq -r .url "$CACHE/$N.json" 2>/dev/null | clip && notify "$N" "Link copied"
    exit ;;
  --web) set_pr "$2" && gh pr view "$N" -R "$REPO" --web >/dev/null 2>&1; exit ;;
  --prefetch) prefetch; exit ;;
  --action) set_pr "$3" && action "$2" "$N"; exit ;;
  --full) set_pr "$2" && open_full "$N"; exit ;;
  --approve-ui) approve_ui; exit ;;
esac

# ------------------------------------------------------------------ CLI
popup=""
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help) usage; exit 0 ;;
    -V | --version) echo "sangam $VERSION"; exit 0 ;;
    doctor) doctor; exit ;;
    mcp) mcp_server; exit ;;
    call) shift; agent_call "$@"; exit ;;
    -C) [ -n "$2" ] || die "-C needs a directory"; cd "$2" || exit 1; shift 2 ;;
    --popup) popup=${2:-G}; shift 2 ;;
    --session) shift ;;   # tmux-gh-pr's old entry point
    *) printf 'sangam: unknown option %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
open_session "$popup"
