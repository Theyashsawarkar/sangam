)

signed_in() { gh auth status 2>&1 | sed -n 's/.*Logged in to github.com account \([^ ]*\).*/\1/p'; }
gh_active() { gh config get user -h github.com 2>/dev/null; }

# The account sangam shows, and the tmux bar counts: the one picked with u
# (if still signed in; empty there means all accounts), else gh's active
# one. Prints nothing for all accounts.
picked_account() {
  local p
  if [ -f "$CROOT/last-account" ]; then
    p=$(<"$CROOT/last-account")
    [ -n "$p" ] && signed_in | grep -qixF "$p" && echo "$p"
    return 0
  fi
  gh_active
}

# accounts_for <account arg>: the accounts to search, one per line.
accounts_for() {
  local all; all=$(signed_in)
  [ -n "$all" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  case ${1,,} in
    all) echo "$all" ;;
    "") local p; p=$(picked_account); if [ -n "$p" ]; then echo "$p"; else echo "$all"; fi ;;
    *) grep -ixF "$1" <<<"$all" || { echo "$1 isn't signed in to gh (signed in: $(paste -sd' ' <<<"$all"))"; return 1; } ;;
  esac
}

arg() { jq -r --arg k "$1" '.[$k] // empty | tostring' <<<"$ARGS"; }

# parse_pr <owner/repo#N | URL>: sets REPO and N.
parse_pr() {
  if [[ $1 =~ github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || [[ $1 =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then
    REPO=${BASH_REMATCH[1]} N=${BASH_REMATCH[2]}
  else
    echo "pr must be owner/repo#number or a pull request URL, not \"$1\""; return 1
  fi
}

# use_account <account arg>: acts as the account asked for, else the first of
# sangam's pick, gh's active one and the rest that can see REPO#N. Sets ACCT
# and exports its GH_TOKEN.
use_account() {
  local a t cands
  if [ -n "$1" ] && [ "${1,,}" != all ]; then cands=$(accounts_for "$1") || { echo "$cands"; return 1; }
  else cands=$({ picked_account; gh_active; signed_in; } | awk 'NF && !seen[tolower($0)]++'); fi
  [ -n "$cands" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  for a in $cands; do
    t=$(token "$a") || continue
    if GH_TOKEN=$t timeout 30 gh api "repos/$REPO/pulls/$N" --jq .number >/dev/null 2>&1; then
      ACCT=$a; export GH_TOKEN=$t; return 0
    fi
  done
  echo "$REPO#$N wasn't found, or none of these accounts can see it: $(paste -sd' ' <<<"$cands")"; return 1
}

search_count() {  # search_count <account> <query>
  GH_TOKEN=$(token "$1") timeout 30 gh api -X GET search/issues -f q="$2" -f per_page=1 --jq .total_count
}

tool_pr_accounts() {
  local all; all=$(signed_in)
  [ -n "$all" ] || { echo "gh isn't signed in to github.com: run gh auth login"; return 1; }
  echo "Signed in: $(paste -sd' ' <<<"$all")"
  echo "gh's active account: $(gh_active)"
  if [ -f "$CROOT/last-account" ]; then echo "Picked in sangam (the default here, and what the tmux bar counts): $(picked_account | grep . || echo 'all accounts')"
  else echo "Nothing picked in sangam: the default here (and the tmux bar) is gh's active account"; fi
}

tool_pr_counts() {
  local accts a n p tn=0 tp=0 k=0
  accts=$(accounts_for "$(arg account)") || { echo "$accts"; return 1; }
  for a in $accts; do
    n=$(search_count "$a" 'is:pr is:open archived:false review-requested:@me') || { echo "$a: GitHub didn't answer (offline?)"; return 1; }
    p=$(search_count "$a" 'is:pr is:open archived:false author:@me') || { echo "$a: GitHub didn't answer (offline?)"; return 1; }
    echo "$a: $n waiting for your review, $p of your own open"
    tn=$((tn + n)) tp=$((tp + p)) k=$((k + 1))
  done
  ((k > 1)) && echo "all: $tn waiting for your review, $tp of your own open"
  return 0
}

# One search as one account: a line per PR.
agent_search() {  # agent_search <account> <query> <state> <limit>
  local st out
  case $3 in merged) st=is:merged ;; closed) st='is:closed is:unmerged' ;; all) st= ;; *) st=is:open ;; esac
  out=$(GH_TOKEN=$(token "$1") timeout 60 gh api graphql -f query="$SEARCH" -f q="is:pr archived:false $2 $st sort:updated-desc" \
    --jq '[.data.search.nodes[] | select(.number)]' 2>&1) || { echo "  (GitHub said: ${out:0:300})"; return 1; }
  jq -r --argjson lim "$4" "$JQ_DEFS"'
    if length == 0 then "  (none)" else
    (.[:$lim][] | "  \(.repository.nameWithOwner)#\(.number)  \(.title)\n      by \(.author.login // "ghost") · \(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end) · updated \(ago(.updatedAt)) ago · +\(.additions) −\(.deletions) · checks \((.commits.nodes[0].commit.statusCheckRollup.state // "none") | ascii_downcase) · review \((.reviewDecision // "none") | ascii_downcase)"),
    (if length > $lim then "  (\(length - $lim) more not shown; raise limit or narrow the search)" elif length == 50 then "  (maybe more: narrow the search)" else empty end) end' <<<"$out"
}

tool_pr_list() {
  local q sec st lim accts a name sa sq found=0
  q=$(arg query) sec=$(arg section) st=$(arg state) lim=$(arg limit)
  case ${st:-open} in open | merged | closed | all) ;; *) echo "state is open, merged, closed or all"; return 1 ;; esac
  accts=$(accounts_for "$(arg account)") || { echo "$accts"; return 1; }
  q=$(sed -E 's/(^| )is:pr( |$)/ /g' <<<"$q")
  echo "<untrusted>"
  if [ -n "$q" ] && [ -z "$sec" ]; then
    lim=${lim:-30}
    for a in $accts; do echo "As $a, \"$q\" (${st:-open}):"; agent_search "$a" "$q" "$st" "$(clamp "$lim")"; done
  else
    [ -f "$CONFIG" ] || default_config
    lim=${lim:-$([ -n "$sec" ] && echo 30 || echo 10)}
    while IFS=$'\t' read -r name sa sq; do
      [ -n "$sec" ] && [[ ${name,,} != "${sec,,}"* ]] && continue
      found=1
      [ -n "$q" ] && sq+=" $q"
      for a in $accts; do
        [ -n "$sa" ] && [ "${sa,,}" != "${a,,}" ] && continue
        echo "$name, as $a (${st:-open}):"; agent_search "$a" "$sq" "$st" "$(clamp "$lim")"
      done
    done < <(sed -e 's/#.*//' "$CONFIG" | awk -F'|' 'NF >= 3 { for (i = 1; i <= 3; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i); if ($1 != "") print $1 "\t" $2 "\t" $3 }')
  fi
  echo "</untrusted>"
  if [ -n "$sec" ] && ((!found)); then
    echo "No section \"$sec\". Sections: $(sed -e 's/#.*//' "$CONFIG" | awk -F'|' 'NF >= 3 { gsub(/^[ \t]+|[ \t]+$/, "", $1); if ($1 != "" && !seen[$1]++) printf "%s; ", $1 }')"; return 1
  fi
  return 0
}
clamp() { local n=${1//[^0-9]/}; n=${n:-30}; ((n < 1)) && n=1; ((n > 50)) && n=50; echo "$n"; }

tool_pr_view() {
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local j rc
  j=$(timeout 60 gh pr view "$N" -R "$REPO" --json "$VIEW_FIELDS" 2>&1) || { echo "gh pr view: ${j:0:300}"; return 1; }
  rc=$(timeout 60 gh api "repos/$REPO/pulls/$N/comments" --paginate 2>/dev/null | jq -s 'add // []' 2>/dev/null) || rc='[]'
  jq -r --arg acct "$ACCT" --arg repo "$REPO" --argjson rc "${rc:-[]}" "$JQ_DEFS"'
    "\($repo)#\(.number): \(.title)", .url, "(read as \($acct))", "",
    "State: \(.state | ascii_downcase)\(if .isDraft then ", draft" else "" end) · by \(.author.login) · \(.headRefName) → \(.baseRefName)\(if .isCrossRepository then " (from a fork)" else "" end)",
    "Created \(ago(.createdAt)) ago, updated \(ago(.updatedAt)) ago\(if .mergedAt then ", merged \(ago(.mergedAt)) ago" elif .closedAt then ", closed \(ago(.closedAt)) ago" else "" end)",
    "Mergeable: \(.mergeable | ascii_downcase) (\(.mergeStateStatus | ascii_downcase)) · review: \((.reviewDecision // "none") | ascii_downcase) · checks: \(ci)",
    "+\(.additions) −\(.deletions) in \(.changedFiles) files",
    (if (.labels | length) > 0 then "Labels: \([.labels[].name] | join(", "))" else empty end),
    (if (.assignees | length) > 0 then "Assignees: \([.assignees[].login] | join(", "))" else empty end),
    (if (.reviewRequests | length) > 0 then "Review requested from: \([.reviewRequests[] | .login // .name // .slug] | join(", "))" else empty end),
    (if (.latestReviews | length) > 0 then "Reviews: \([.latestReviews[] | "\(.author.login) \(.state | ascii_downcase)"] | join(", "))" else empty end),
    (if (.statusCheckRollup | length) > 0 then "", "Checks:",
      (.statusCheckRollup[] | "  \(.name // .context): \((.conclusion // .state // .status // "?") | ascii_downcase)\(if ((.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE")) then "  \(.detailsUrl // .targetUrl // "")" else "" end)") else empty end),
    "", "Files:", (.files[:150][] | "  \(.path)  +\(.additions) −\(.deletions)"),
    (if (.files | length) > 150 then "  (\(.files | length) files; first 150 shown)" else empty end),
    "", "<untrusted>", "Description:", (if (.body // "") == "" then "(none)" else .body end),
    (if (.comments | length) > 0 then "", "Comments (\(.comments | length), last 25 shown):",
      (.comments[-25:][] | "--- \(.author.login), \(ago(.createdAt)) ago:", .body) else empty end),
    (if (.reviews | map(select((.body // "") != "")) | length) > 0 then "", "Review summaries:",
      (.reviews | map(select((.body // "") != ""))[-15:][] | "--- \(.author.login) (\(.state | ascii_downcase)):", .body) else empty end),
    (if ($rc | length) > 0 then "", "Inline review comments (\($rc | length), last 40 shown):",
      ($rc[-40:][] | "--- \(.user.login) on \(.path):\(.line // .original_line // "?"):", .body) else empty end),
    "</untrusted>"' <<<"$j"
}

tool_pr_diff() {
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local d f max total
  f=$(arg file) max=$(arg max_lines); max=${max//[^0-9]/}; max=${max:-2000}
  d=$(timeout 90 gh pr diff "$N" -R "$REPO" --color=never 2>&1) || { echo "gh pr diff: ${d:0:300}"; return 1; }
  if [ -n "$f" ]; then
    d=$(awk -v f="$f" '/^diff --git / { p = $4; sub(/^b\//, "", p); on = (p == f || substr(p, length(p) - length(f) + 1) == f) } on' <<<"$d")
    [ -n "$d" ] || { echo "$REPO#$N doesn't change a file \"$f\" (pr_view lists its files)"; return 1; }
  fi
  total=$(wc -l <<<"$d")
  echo "<untrusted>"
  head -n "$max" <<<"$d"
  echo "</untrusted>"
  ((total > max)) && echo "($((total - max)) more lines cut; ask for one file with file=, or a larger max_lines)"
  return 0
}

# ask_approval <what> <details> [<text>]: asks the user. 0 yes (the text,
# maybe edited, in $ASKED_TEXT), 1 no or no answer in time, 2 no way to ask.
ask_approval() {
  local d shown=0 i c
  d=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/sangam-ask.XXXXXX") || return 2
  printf '%s' "$1" >"$d/what"; printf '%s\n' "$2" >"$d/details"
  printf '%s' "${ASK_WHO:-An agent}" >"$d/who"; printf '%s' "${ASK_WHY:-}" >"$d/why"
  date +%s >"$d/since"
  # What the screen shows (approve_ui): the sentence, labels, details, the frame.
  printf '%s' "${ASK_KIND:-Request}" >"$d/kind"; printf '%s' "${ASK_REF:-}" >"$d/ref"; printf '%s' "${ASK_TONE:-care}" >"$d/tone"
  printf '%s' "${ASK_SAY-$1}" >"$d/say"; printf '%s' "${ASK_TARGET:-}" >"$d/target"; printf '%s' "${ASK_AFTER:-}" >"$d/after"
  printf '%s' "${ASK_ACTION:-Approve}" >"$d/action"; printf '%s' "${ASK_TITLE:-the text, as it will show}" >"$d/title"
  printf '%s' "${ASK_CHIPS:-}" >"$d/chips"; printf '%s' "${ASK_FACTS:-}" >"$d/facts"; printf '%s' "${ASK_FRAME:-}" >"$d/frame"
  printf '%s' "${ASK_URL:-}" >"$d/url"; printf '%s' "${ASK_LOG:-}" >"$d/log"
  [ -n "${ASK_DIFF:-}" ] && printf '%s\n' "$ASK_DIFF" >"$d/diff"
  [ $# -ge 3 ] && { printf '%s' "$3" >"$d/text"; printf '%s' "$3" >"$d/orig"; }
  # A tmux popup: on the agent's own pane when it runs in tmux, else on the
  # tmux client used last.
  if command -v tmux >/dev/null && tmux list-clients >/dev/null 2>&1; then
    local target=()
    if [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ]; then target=(-t "$TMUX_PANE")
    else
      c=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
      [ -n "$c" ] && target=(-c "$c")
    fi
    if [ ${#target[@]} -gt 0 ] && tmux display-popup "${target[@]}" -E -B -w 84% -h 80% \
        "SANGAM_ASK='$d' '$self' --approve-ui" 2>/dev/null; then
      shown=1
      command -v notify-send >/dev/null && notify-send -a sangam ${ICON:+-i "$ICON"} "${ASK_WHO:-An agent} wants to $1" "Answer in the tmux popup." 2>/dev/null &
    fi
  fi
  # No tmux: a notification with Approve / Decline buttons (no editing).
  if ((!shown)) && command -v notify-send >/dev/null; then
    ( a=$(timeout "$ASK_TIMEOUT" notify-send -a sangam ${ICON:+-i "$ICON"} -u critical -t 0 --wait \
          -A yes=Approve -A no=Decline "${ASK_WHO:-An agent} wants to $1" "$(head -c 600 "$d/details"; [ -f "$d/text" ] && { echo; head -c 600 "$d/text"; })" 2>/dev/null)
      [ -e "$d/answer" ] || echo "${a:-no}" >"$d/answer" ) &
    shown=1
  fi
  ((shown)) || { rm -rf "$d"; return 2; }
  for ((i = 0; i < ASK_TIMEOUT * 2; i++)); do [ -s "$d/answer" ] && break; sleep 0.5; done
  ASKED_TEXT=$(cat "$d/text" 2>/dev/null)
  local ans; ans=$(cat "$d/answer" 2>/dev/null)
  rm -rf "$d"
  [ "$ans" = yes ]
}

# --approve-ui: the popup's screen, for the request in $SANGAM_ASK. Drawn once
# (and again after a resize, an edit or a scroll); each second only the
# countdown is rewritten, in place: redrawing it all is what used to flicker.
at() { printf '\e[%d;%dH' "$1" "$2"; }

# cut_to <text> <width>: the text, ending in … when it's longer
cut_to() { if ((${#1} > $2)); then printf '%s…' "${1:0:$(($2 > 1 ? $2 - 1 : 0))}"; else printf '%s' "$1"; fi; }

# chip <warn|bad|edit|plain> <text>
chip() {
  case $1 in
    warn) printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s \e[0m' "$RGB_GOLD" "$RGB_INK" "$2" ;;
    bad) printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s \e[0m' "$RGB_RED" "$RGB_INK" "$2" ;;
    edit) printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s \e[0m' "$RGB_GREEN" "$RGB_INK" "$2" ;;
    *) printf '\e[48;2;%sm%s %s \e[0m' "$RGB_SEL" "$fg" "$2" ;;
  esac
}

# action <key> <what> [go|stop]: an answer, its key then what it does
action() {
  case ${3:-} in
    go) printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s  %s \e[0m' "$RGB_GREEN" "$RGB_INK" "$1" "$2" ;;
    danger) printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s  %s \e[0m' "$RGB_RED" "$RGB_INK" "$1" "$2" ;;
    stop) printf '%s\e[1m %s  %s %s' "$red" "$1" "$2" "$r" ;;
    *) printf '\e[48;2;%sm%s %s %s %s%s' "$RGB_SEL" "$fg" "$1" "$r" "$sub$2" "$r" ;;
  esac
}

# The frame's lines, wrapped to its width: the text as markdown, or the
# prepared frame. Cached in FRAME until the width or the text changes.
frame_lines() {
  local w=$1 d=$2
  if [ -f "$d/text" ]; then
    # as GitHub shows it: headings bold without their #, `code` and @tags marked
    mapfile -t FRAME < <(indent_fold "$w" <"$d/text" | sed -E \
      -e "s/^#{1,6} +(.*)\$/$b$fg\1$r/" -e "s/\*\*([^*]+)\*\*/$b\1$r/g" -e "s/\`([^\`]+)\`/$gold\1$r/g" \
      -e "s/(^|[^[:alnum:]_])(@[[:alnum:]][[:alnum:]-]*)/\1$gold\2$r/g")
  else
    mapfile -t FRAME < <(indent_fold "$w" <"$d/frame" | sed -E \
      -e "s/^([^ ].*)\$/$dim\1$r/" -e "s/^  ([0-9a-f]{7})  /  $gold\1$r  /" \
      -e "s/^  ✗ /  $red✗$r /" -e "s/^  ✓ /  $green✓$r /" -e "s/^  ○ /  $gold○$r /" -e "s/^    (.*)\$/    $dim\1$r/")
  fi
}

# indent_fold <width>: fold -s, a long line's next lines indented like it
indent_fold() {
  local l pre
  while IFS= read -r l || [ -n "$l" ]; do
    pre=${l%%[! ]*}
    if ((${#l} <= $1)) || ((${#pre} >= $1 / 2)); then fold -s -w "$1" <<<"$l"
    else fold -s -w $(($1 - ${#pre})) <<<"${l:${#pre}}" | sed "s/^/$pre/"; fi
  done
}

approve_draw() {
  local d=$1 W H cw two factw row="" line c lab val n i tone who title
  W=$(tput cols) H=$(tput lines); cw=$((W - 6)); ((cw < 20)) && cw=20
  case $(cat "$d/tone") in danger) tone=$red ;; safe) tone=$rose ;; *) tone=$gold ;; esac
  who=$(cat "$d/who"); title=" sangam · approve a $(tr '[:upper:]' '[:lower:]' <"$d/kind" | sed 's/^auto-merge$/merge/') "
  printf '\e[2J'
  # the border says how much is at stake
  at 1 1; printf '%s╭─%s' "$tone" "$title"; printf '─%.0s' $(seq 1 $((W - 3 - ${#title} > 0 ? W - 3 - ${#title} : 1))); printf '╮'
  for ((i = 2; i < H; i++)); do at "$i" 1; printf '│'; at "$i" "$W"; printf '│'; done
  at "$H" 1; printf '╰'; printf '─%.0s' $(seq 1 $((W - 2 > 0 ? W - 2 : 1))); printf '╯%s' "$r"
  # the top: what kind, which PR, and (top right) the time left
  row=2
  at "$row" 4; printf '\e[48;2;%sm\e[38;2;%sm\e[1m %s \e[0m  %s%s%s' "$RGB_PURPLE" "$RGB_INK" "$(cat "$d/kind")" "$dim" "$(cat "$d/ref")" "$r"
  CLOCK_ROW=$row CLOCK_COL=$((W - 29))
  # one sentence: who wants what
  row=$((row + 2))
  local say target after plain
  say=$(cat "$d/say") target=$(cat "$d/target") after=$(cat "$d/after"); say=${say:+$say }; plain="$who wants to $say$target$after"
  if ((${#plain} <= cw)); then
    at "$row" 4; printf '%s%s wants to %s%s%s%s%s%s%s' "$b$fg" "$who" "$say" "$r" "$tone$b" "$target" "$r" "$b$fg" "$after$r"; row=$((row + 1))
  else
    while IFS= read -r line; do at "$row" 4; printf '%s%s%s' "$b$fg" "$line" "$r"; row=$((row + 1)); done < <(fold -s -w "$cw" <<<"$plain")
  fi
  if [ -s "$d/why" ]; then
    at "$row" 4; printf '%sYou asked:%s %s"%s"%s' "$dim" "$r" "$sub" "$(head -c $((cw > 12 ? cw - 12 : 8)) "$d/why" | tr '\n' ' ')" "$r"; row=$((row + 1))
  fi
  # labels for what you mustn't miss
  local x=4 kind text
  row=$((row + 1))
  { [ -f "$d/text" ] && ! cmp -s "$d/text" "$d/orig" && printf 'edit\tedited by you: y posts your version\n'; cat "$d/chips"; } >"$d/.chips"
  while IFS=$'\t' read -r kind text || [ -n "$kind" ]; do
    [ -n "$text" ] || continue
    if ((x + ${#text} + 3 > W - 2)); then x=4 row=$((row + 1)); fi
    at "$row" "$x"; chip "$kind" "$text"; x=$((x + ${#text} + 3))
  done <"$d/.chips"
  row=$((row + 2))
  # the answers, pinned to the bottom: one row, or two when that's too narrow
  local foot=$((H - 1)) edited=0 hint="j/k scroll" acts=() a w1=0
  [ -f "$d/text" ] && ! cmp -s "$d/text" "$d/orig" && edited=1
  case $(cat "$d/kind") in Merge | Auto-merge) hint="Enter does nothing here" ;; esac
  if ((edited)); then acts+=("$(action y "$(cat "$d/action") (my version)" go)")
  elif [ "$(cat "$d/tone")" = danger ]; then acts+=("$(action y "$(cat "$d/action")" danger)")
  else acts+=("$(action y "$(cat "$d/action")" go)"); fi
  [ -f "$d/text" ] && acts+=("$(action e "$( ((edited)) && echo "Edit again" || echo "Edit first")")")
  ((edited)) && acts+=("$(action u "Undo my edit")")
  acts+=("$(action n Decline stop)")
  [ -s "$d/log" ] && acts+=("$(action l "Open the failed log")")
  [ -s "$d/diff" ] && acts+=("$(action d "View the diff")")
  [ -s "$d/url" ] && acts+=("$(action b "Open on GitHub")")
  ACTIONS="" ACTIONS2=""
  for a in "${acts[@]}"; do
    w1=$((w1 + $(vis_len "$a") + 2))
    if ((w1 - 2 <= cw)) && [ -z "$ACTIONS2" ]; then ACTIONS+="$a  "; else ACTIONS2+="$a  "; fi
  done
  if [ -z "$ACTIONS2" ] && ((w1 + ${#hint} <= cw)); then
    ACTIONS+=$(printf '%*s%s%s%s' $((cw - w1 - ${#hint})) '' "$dim" "$hint" "$r")
  fi
  if [ -n "$ACTIONS2" ]; then foot=$((H - 2)); fi
  # the middle: details beside the frame, or above it when narrow
  local bot=$((foot - 2)) top=$row fx fw fh
  ((bot < top + 2)) && bot=$((top + 2))
  two=0; ((cw >= 90)) && two=1
  factw=$((two ? (cw / 3 + 4 > 44 ? 44 : cw / 3 + 4) : cw))
  n=$top
  local stop=$bot; ((two)) || stop=$((bot - 5))
  while IFS=$'\t' read -r c lab val || [ -n "$c" ]; do
    ((n > stop)) && break
    at "$n" 4
    case $c in
      H) printf '%s%s%s' "$dim" "${lab:0:factw}" "$r" ;;
      P) printf '%s·%s %s %s%s%s' "$dim" "$r" "$(cut_to "$lab" $((factw - 4 - ${#val})))" "$dim" "$val" "$r" ;;
      F) case $lab in
           ✓) printf '%s\e[1m%s%s %s' "$green" "$lab" "$r" "$(cut_to "$val" $((factw - 2)))" ;;
           ✗) printf '%s\e[1m%s%s %s' "$red" "$lab" "$r" "$(cut_to "$val" $((factw - 2)))" ;;
           ○) printf '%s\e[1m%s%s %s' "$gold" "$lab" "$r" "$(cut_to "$val" $((factw - 2)))" ;;
           ·) printf '%s%s %s%s' "$dim" "$lab" "$(cut_to "$val" $((factw - 2)))" "$r" ;;
           ●) printf '%s\e[1m%s%s %s' "$gold" "$lab" "$r" "$(cut_to "$val" $((factw - 2)))" ;;
           *) printf '%s%-8s%s %s' "$dim" "$lab" "$r" "$(cut_to "$val" $((factw - 9)))" ;;
         esac ;;
    esac
    n=$((n + 1))
  done < <(cat "$d/facts")
  ((two)) && { fx=$((4 + factw + 2)); fw=$((W - fx - 2)); } || { top=$((n + 1)); fx=4; fw=$cw; }
  ((bot > foot - 1)) && bot=$((foot - 1))
  fh=$((bot - top - 1))
  FX=$fx FW=$fw FTOP=$top FH=$fh
  # no room for the frame (a tiny terminal): just the answers
  if ((fh < 1)); then FH=0; approve_actions "$foot"; return; fi
  frame_lines "$((fw - 4))" "$d"
  # its edges
  title=" $(cat "$d/title") "
  at "$top" "$fx"; printf '%s╭─%s%s%s%s' "$dim" "$r" "$dim$title" "" ""; printf '─%.0s' $(seq 1 $((fw - 3 - ${#title} > 0 ? fw - 3 - ${#title} : 1))); printf '╮%s' "$r"
  for ((i = 1; i <= fh; i++)); do at "$((top + i))" "$fx"; printf '%s│%s' "$dim" "$r"; at "$((top + i))" "$((fx + fw - 1))"; printf '%s│%s' "$dim" "$r"; done
  at "$((top + fh + 1))" "$fx"; printf '%s╰' "$dim"; printf '─%.0s' $(seq 1 $((fw - 2 > 0 ? fw - 2 : 1))); printf '╯%s' "$r"
  approve_frame
  approve_actions "$foot"
}

approve_actions() {
  at "$1" 4; printf '%s' "$ACTIONS"
  [ -n "$ACTIONS2" ] && { at "$(($1 + 1))" 4; printf '%s' "$ACTIONS2"; }
  return 0
}

# vis_len <text>: its width on screen, colours left out
vis_len() { local t; t=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$1"); printf '%s' "${#t}"; }

# approve_result <yes|no|expired> <dir>: a moment saying what your answer did,
# then the popup closes. The answer is already written: the agent goes on.
approve_result() {
  local d=$2 W H big sub tiny col kind
  W=$(tput cols) H=$(tput lines); kind=$(cat "$d/kind" 2>/dev/null)
  case $1 in
    yes) col=$green big="✓ Approved"
      case $kind in
        Merge) sub="It merges into $(cat "$d/target") now." ;;
        Auto-merge) sub="Auto-merge goes on now: it merges once it's ready." ;;
        Comment) sub="The comment is posted now." ;;
        Review) sub="The review is submitted now." ;;
        *) sub="It goes ahead now." ;;
      esac
      tiny="closing" ;;
    no) col=$red big="✗ Declined" sub="Nothing was done. $(cat "$d/who") has been told." tiny="closing" ;;
    *) col=$gold big="Expired: no answer in $((ASK_TIMEOUT / 60)) minutes" sub="Counted as a no. Nothing was done." tiny="the agent can ask again" ;;
  esac
  printf '\e[2J'
  at $((H / 2 - 1)) $(((W - ${#big}) / 2 > 1 ? (W - ${#big}) / 2 : 1)); printf '%s\e[1m%s%s' "$col" "$(cut_to "$big" $((W - 2)))" "$r"
  at $((H / 2)) $(((W - ${#sub}) / 2 > 1 ? (W - ${#sub}) / 2 : 1)); printf '%s%s%s' "$fg" "$(cut_to "$sub" $((W - 2)))" "$r"
  at $((H / 2 + 1)) $(((W - ${#tiny}) / 2 > 1 ? (W - ${#tiny}) / 2 : 1)); printf '%s%s%s' "$dim" "$tiny" "$r"
  sleep "${SANGAM_RESULT_SECS:-0.9}"
}

# The frame's inside, at the current scroll. No clearing: each row is
# overwritten, so scrolling doesn't flash either.
approve_frame() {
  local i l blank; ((FH > 0)) || return 0
  printf -v blank '%*s' "$((FW - 2))" ''
  ((SCROLL > ${#FRAME[@]} - FH)) && SCROLL=$((${#FRAME[@]} - FH))
  ((SCROLL < 0)) && SCROLL=0
  for ((i = 0; i < FH; i++)); do
    l=${FRAME[SCROLL + i]:-}
    at "$((FTOP + 1 + i))" "$((FX + 1))"; printf '%s' "$blank"
    at "$((FTOP + 1 + i))" "$((FX + 2))"; printf '%s%s' "$l" "$r"
  done
  if ((${#FRAME[@]} > FH)); then
    at "$FTOP" "$((FX + FW - 18))"; printf '%s %d-%d of %d j/k %s' "$dim" "$((SCROLL + 1))" "$((SCROLL + FH))" "${#FRAME[@]}" "$r"
  fi
}

# upgrade_request <dir>: a request from a sangam before 2.3 (an agent's MCP
# server started before the update keeps its old code) has only what, details
# and maybe who, why, risk, extra. Read them into the fields the popup draws,
# so it shows the same screen: never ask with less shown.
upgrade_request() {
  local d=$1 what ref="" kind=Request say tone=care target="" after="" action=Approve title chips="" facts="" frame=""
  local l title_line="" branch="" ready="" as="" del="" mergeable="" review="" checks="" base="" head=""
  what=$(cat "$d/what" 2>/dev/null)
  [[ $what =~ ([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+) ]] && ref=${BASH_REMATCH[1]}
  { read -r title_line; while IFS= read -r l; do
      case $l in
        *' → '*) branch=$l ;;
        mergeable:*) ready=$l ;;
        'as '*) as=${l#as }; [[ $as == *', then delete the branch' ]] && { del=1; as=${as%, then delete the branch}; } ;;
      esac
    done; } <"$d/details"
  if [ -n "$branch" ]; then head=${branch%% → *} base=${branch#* → } base=${base%% ·*}; fi
  if [ -n "$ready" ]; then
    mergeable=$(sed -n 's/^mergeable: \([a-z_]*\).*/\1/p' <<<"$ready")
    review=$(sed -n 's/.*review: \([a-z_]*\).*/\1/p' <<<"$ready")
    checks=$(sed -n 's/.*checks: \([a-z]*\).*/\1/p' <<<"$ready")
  fi
  case $what in
    *auto-merge*) kind=Auto-merge tone=danger say="merge into" target=${base:-its base} after=" by itself, once it's ready" action="Turn on auto-merge" ;;
    *merge*)
      kind=Merge tone=danger target=${base:-its base} action="Merge into ${base:-its base}"
      case $what in *squash*) say="squash and merge into" ;; *rebase*) say="rebase and merge into" ;; *) say="merge into" ;; esac ;;
    'comment on'*) kind=Comment say="comment on" target=$ref action="Post the comment" ;;
    'request changes'*) kind=Review say="" target="request changes" after=${as:+ as $as} action="Submit the review" ;;
    approve*) kind=Review say="" target="approve" after=${as:+ as $as} action="Approve the PR" ;;
    *) say=${what% "$ref"}; target=$ref ;;
  esac
  title=${title_line:-the request}
  # readiness, as the new popup shows it
  if [ -n "$ready" ]; then
    local nr=0 rows=""
    case $checks in pass) rows+=$'F\t✓\tChecks: passed\n' ;; fail) rows+=$'F\t✗\tChecks: failed\n'; nr=1 ;; pending) rows+=$'F\t○\tChecks: running\n'; nr=1 ;; *) rows+=$'F\t·\tChecks: none\n' ;; esac
    case $review in approved) rows+=$'F\t✓\tReview: approved\n' ;; changes_requested) rows+=$'F\t✗\tReview: changes requested\n'; nr=1 ;; review_required) rows+=$'F\t○\tReview: needs an approval\n'; nr=1 ;; *) rows+=$'F\t·\tReview: none required\n' ;; esac
    case $mergeable in mergeable) rows+=$'F\t✓\tNo conflicts\n' ;; conflicting) rows+=$'F\t✗\tHas conflicts\n'; nr=1 ;; *) rows+=$'F\t○\tChecking for conflicts\n'; nr=1 ;; esac
    facts=$(printf 'H\t%s\n%s' "$( ((nr)) && echo "Not ready yet" || echo "Ready to merge")" "$rows")
    ((nr)) && chips+=$'bad\tnot ready\n'
  fi
  [ "$tone" = danger ] && chips+="bad"$'\t'"lands on ${base:-its base}"$'\n'
  [ "$kind" = Auto-merge ] && chips+=$'warn\tmerges later, without asking again\n'
  [ "$tone" = danger ] && chips+=$'plain\tundo is a revert\n'
  [ -n "$del" ] && chips+=$'plain\tdeletes the branch\n'
  case $kind in Comment) chips+=$'warn\tpublic on the PR\nplain\tnotifies the people on it\n' ;;
    Review) [ "$say" = "request changes on" ] && chips+=$'warn\tblocks the merge until resolved\n'; chips+=$'plain\tpublic on the PR\n' ;; esac
  [ -s "$d/risk" ] && [ -z "$chips" ] && chips="warn"$'\t'"$(cat "$d/risk")"$'\n'
  [ -n "$facts" ] && facts+=$'\nH\t \n'
  facts+=$'H\t'"$([ -n "$branch" ] && echo "The merge" || echo "The pull request")"$'\n'
  [ -n "$ref" ] && facts+="F"$'\t'"PR"$'\t'"$ref"$'\n'
  [ -f "$d/text" ] && [ -n "$title_line" ] && facts+="F"$'\t'"Title"$'\t'"$title_line"$'\n'
  [ -n "$head" ] && facts+="F"$'\t'"From"$'\t'"$head"$'\n'"F"$'\t'"Into"$'\t'"$base"$'\n'
  [ -n "$as" ] && facts+="F"$'\t'"As"$'\t'"$as"$'\n'
  frame=$(if [ -s "$d/extra" ]; then sed 's/^commits that land:/Commits that land/; s/^}*after merging: /\nWhat happens next\n  /' "$d/extra"
    elif [ -n "$base" ]; then printf 'What happens next\n  %s gets it\n' "$base"; [ -n "$del" ] && printf '  %s is deleted\n' "$head"
    else echo "$title"; fi)
  printf '%s' "$kind" >"$d/kind"; printf '%s' "$ref" >"$d/ref"; printf '%s' "$tone" >"$d/tone"; printf '%s' "$say" >"$d/say"
  printf '%s' "$target" >"$d/target"; printf '%s' "$after" >"$d/after"; printf '%s' "$action" >"$d/action"
  printf '%s' "$([ -f "$d/text" ] && echo "the text, as it will show" || echo "$title")" >"$d/title"
  printf '%s' "$chips" >"$d/chips"; printf '%s' "$facts" >"$d/facts"; printf '%s\n' "$frame" >"$d/frame"
  [ -s "$d/who" ] || printf 'An agent' >"$d/who"; [ -e "$d/why" ] || : >"$d/why"
  : >"$d/url"; : >"$d/log"; [ -f "$d/text" ] && cp "$d/text" "$d/orig"
  [ -e "$d/since" ] || date +%s >"$d/since"
}

approve_ui() {
  local d=$SANGAM_ASK k left shown="" since redraw=1 ed line f
  [ -d "$d" ] || exit 1
  trap '[ -s "$d/answer" ] || echo no >"$d/answer"; printf "\e[?25h\e[?1049l"' EXIT
  trap 'redraw=1' WINCH
  since=$(cat "$d/since" 2>/dev/null || date +%s)
  [ -e "$d/kind" ] || upgrade_request "$d"
  SCROLL=0
  printf '\e[?1049h\e[?25l'
  # A popup can open while you're typing elsewhere: what you were typing
  # can't answer it.
  while IFS= read -rsn1 -t 0.4 _; do :; done
  while :; do
    left=$((ASK_TIMEOUT - $(date +%s) + since))
    ((left > 0)) || { echo no >"$d/answer"; approve_result expired "$d"; return; }
    if ((redraw)); then redraw=0 shown=""; approve_draw "$d"; fi
    if [ "$left" != "$shown" ]; then
      shown=$left
      at "$CLOCK_ROW" "$CLOCK_COL"; printf '%s%26s%s' "$dim" "$(printf 'no answer in %d:%02d is a no' $((left / 60)) $((left % 60)))" "$r"
    fi
    k=""; IFS= read -rsn1 -t 1 k || continue
    case $k in
      y | Y) echo yes >"$d/answer"; approve_result yes "$d"; return ;;
      n | N | q | $'\e') echo no >"$d/answer"; approve_result no "$d"; return ;;
      j) SCROLL=$((SCROLL + 1)); approve_frame ;;
      k) SCROLL=$((SCROLL - 1)); approve_frame ;;
      e | E)  # an editor with arguments (code --wait) splits into words
        [ -f "$d/text" ] || continue
        read -ra ed <<<"${VISUAL:-${EDITOR:-vi}}"
        printf '\e[?25h\e[?1049l'; "${ed[@]}" "$d/text" </dev/tty >/dev/tty; printf '\e[?1049h\e[?25l'
        SCROLL=0 redraw=1 ;;
      u | U) [ -f "$d/orig" ] && cp "$d/orig" "$d/text"; SCROLL=0 redraw=1 ;;
      d | D) [ -s "$d/diff" ] || continue
        printf '\e[?25h\e[?1049l'; ${PAGER:-less -R} "$d/diff" </dev/tty >/dev/tty; printf '\e[?1049h\e[?25l'; redraw=1 ;;
      l | L) [ -s "$d/log" ] && xdg-open "$(cat "$d/log")" >/dev/null 2>&1 & ;;
      b | B) [ -s "$d/url" ] && xdg-open "$(cat "$d/url")" >/dev/null 2>&1 & ;;
    esac
  done
}

# asked <what> <details> [<text>]: ask_approval, and the reply when it's not a yes.
asked() {
  ask_approval "$@"
  case $? in
    0) return 0 ;;
    2) echo "Nothing done: there's no tmux client or notification daemon to ask the user for approval."; return 1 ;;
    *) echo "Nothing done: the user declined (or didn't answer within $((ASK_TIMEOUT / 60)) minutes)."; return 1 ;;
  esac
}

# pr_facts [size]: the PR's title, state and branch as lines for the details
# pane (and its size, for a review), its URL and title for the rest of the
# request, and in PR_JSON what gh said.
pr_facts() {
  PR_JSON=$(timeout 30 gh pr view "$N" -R "$REPO" --json title,state,isDraft,author,headRefName,baseRefName,additions,deletions,changedFiles,url,reviewRequests,latestReviews 2>/dev/null) || PR_JSON='{}'
  ASK_URL=$(jq -r '.url // empty' <<<"$PR_JSON")
  PR_TITLE=$(jq -r '.title // empty' <<<"$PR_JSON")
  ASK_FACTS=$(jq -r --arg size "${1:-}" '
    "H\tThe pull request",
    "F\tTitle\t\(.title // "?")",
    "F\tState\t\((.state // "?") | ascii_downcase)\(if .isDraft then ", draft" else "" end) · by \(.author.login // "?")",
    "F\tBranch\t\(.headRefName // "?") to \(.baseRefName // "?")",
    (if $size != "" then "F\tSize\t+\(.additions // 0) -\(.deletions // 0) in \(.changedFiles // 0) files" else empty end)' <<<"$PR_JSON")
}

# notified <text>: who GitHub tells about a comment or review, one "login\trole"
# a line: the author, the reviewers, anyone the text tags. Not you.
notified() {
  { jq -r '(.author.login // empty | "\(.)\tauthor"),
      ((.reviewRequests // [])[] | (.login // .name // empty) | "\(.)\treviewer"),
      ((.latestReviews // [])[] | .author.login // empty | "\(.)\treviewer")' <<<"$PR_JSON"
    grep -oE '(^|[^[:alnum:]_])@[[:alnum:]][[:alnum:]-]*' <<<"$1" | sed -E 's/^[^@]*@//; s/$/\tmentioned/'
  } | awk -F'\t' -v me="$ACCT" 'tolower($1) != tolower(me) && !seen[tolower($1)]++'
}

# notify_chip <people>: "notifies priya-n", or "notifies 3 people"
notify_chip() {
  local n; n=$(grep -c . <<<"$1")
  case $n in 0) ;; 1) printf 'plain\tnotifies %s\n' "${1%%$'\t'*}" ;; *) printf 'plain\tnotifies %d people\n' "$n" ;; esac
}

tool_pr_comment() {
  local body out people; body=$(arg body)
  [ -n "$body" ] || { echo "body is empty"; return 1; }
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  pr_facts
  people=$(notified "$body")
  [ -n "$people" ] && ASK_FACTS+=$'\nH\t \nH\tWho gets notified\n'$(sed 's/^/P\t/' <<<"$people")
  ASK_WHY=$(arg why) ASK_KIND=Comment ASK_REF="$REPO#$N" ASK_TONE=care ASK_SAY="comment as" ASK_TARGET=$ACCT ASK_ACTION="Post the comment" \
    ASK_TITLE="the comment, as it will show" ASK_CHIPS=$'warn\tpublic on the PR\n'$(notify_chip "$people") \
    asked "comment on $REPO#$N" "$PR_TITLE"$'\n'"as $ACCT" "$body" || return 1
  [ -n "$ASKED_TEXT" ] || { echo "Nothing done: the user emptied the comment."; return 1; }
  out=$(timeout 60 gh pr comment "$N" -R "$REPO" --body-file - <<<"$ASKED_TEXT" 2>&1) || { echo "gh pr comment failed: $out"; return 1; }
  changed
  echo "Posted as $ACCT: $out"
  [ "$ASKED_TEXT" = "$body" ] || printf '\nThe user edited it before posting; what was posted:\n%s\n' "$ASKED_TEXT"
}

tool_pr_review() {
  local ev flag body out; ev=$(arg event) body=$(arg body)
  case $ev in
    approve) flag=--approve ;;
    request_changes) flag=--request-changes ;;
    comment) flag=--comment ;;
    *) echo "event is approve, request_changes or comment"; return 1 ;;
  esac
  [ "$ev" = approve ] || [ -n "$body" ] || { echo "$ev needs a body"; return 1; }
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local verb what chips action icon row before people
  case $ev in
    approve) verb="approve $REPO#$N" what="approve" action="Approve the PR" icon=✓ row="Approve" chips=$'warn\tcounts toward merging\nplain\tpublic on the PR' ;;
    request_changes) verb="request changes on $REPO#$N" what="request changes" action="Submit the review" icon=● row="Request changes" chips=$'warn\tblocks the merge until resolved\nplain\tpublic on the PR' ;;
    *) verb="review $REPO#$N" what="comment in a review" action="Submit the review" icon=· row="Comment, without approving" chips=$'plain\tpublic on the PR' ;;
  esac
  pr_facts size
  # your last review on it, which this one takes the place of
  before=$(jq -r --arg me "$ACCT" '[(.latestReviews // [])[] | select((.author.login // "" | ascii_downcase) == ($me | ascii_downcase)) | .state][-1] // empty' <<<"$PR_JSON")
  people=$(jq -r '.author.login // empty | select(. != "")' <<<"$PR_JSON" | awk -v me="$ACCT" 'tolower($0) != tolower(me)')
  chips+=$'\n'$(notify_chip "${people:+$people$'\t'author}")
  ASK_FACTS+=$'\nH\t \nH\tThis review\nF\t'"$icon"$'\t'"$row"
  case $before:$ev in
    APPROVED:approve | CHANGES_REQUESTED:request_changes) ;;
    APPROVED:*) ASK_FACTS+=$'\nF\t·\tReplaces your earlier approval' ;;
    CHANGES_REQUESTED:*) ASK_FACTS+=$'\nF\t·\tReplaces your earlier request for changes' ;;
  esac
  ASK_WHY=$(arg why) ASK_KIND=Review ASK_REF="$REPO#$N" ASK_TONE=care ASK_SAY="" ASK_TARGET="$what" ASK_AFTER=" as $ACCT" ASK_ACTION=$action \
    ASK_TITLE="the review, as it will show" ASK_CHIPS=$chips ASK_DIFF=$(timeout 20 gh pr diff "$N" -R "$REPO" --color=never 2>/dev/null) \
    asked "$verb" "$PR_TITLE"$'\n'"as $ACCT" "$body" || return 1
  [ "$ev" = approve ] || [ -n "$ASKED_TEXT" ] || { echo "Nothing done: the user emptied the review."; return 1; }
  out=$(timeout 60 gh pr review "$N" -R "$REPO" "$flag" ${ASKED_TEXT:+--body-file -} <<<"$ASKED_TEXT" 2>&1) || { echo "gh pr review failed: $out"; return 1; }
  changed
  echo "Review submitted as $ACCT (${ev/_/ }) on $REPO#$N."
  [ "$ASKED_TEXT" = "$body" ] || printf '\nThe user edited it first; what was submitted:\n%s\n' "$ASKED_TEXT"
}

# count <n> <thing>: "1 commit", "3 commits"
count() { if (($1 == 1)); then printf '1 %s' "$2"; else printf '%d %ss' "$1" "$2"; fi; }

# merge_blockers (gh pr view JSON on stdin): what keeps a PR from merging, a
# line each, failed checks with when and how to see why.
merge_blockers() {
  jq -r '
    def ago: (now - (try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch now)) as $s
      | if $s < 90 then "just now" elif $s < 5400 then "\($s / 60 | floor) minutes ago"
        elif $s < 129600 then "\($s / 3600 | floor) hours ago" else "\($s / 86400 | floor) days ago" end;
    def bad: (.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE");
    def name: if (.workflowName // "") != "" then "\(.workflowName) / \(.name)" else (.name // .context // "a check") end;
    (.statusCheckRollup // []) as $c
    | ([$c[] | select(bad)] | to_entries[]
       | "  ✗ \(.value | name)",
         "    failed \(.value.completedAt // .value.startedAt // .value.createdAt // "" | if . == "" then "" else ago end)\(if .key == 0 and ((.value.detailsUrl // .value.targetUrl // "") != "") then " · l opens the log" else "" end)"),
      ([$c[] | select(((.status // "COMPLETED") != "COMPLETED") or ((.state // "") | test("PENDING|EXPECTED")))] | length
        | select(. > 0) | "  ○ \(.) check\(if . == 1 then "" else "s" end) still running"),
      (if .reviewDecision == "CHANGES_REQUESTED" then
         "  ✗ Changes requested by \([(.latestReviews // [])[] | select(.state == "CHANGES_REQUESTED") | .author.login] | if length > 0 then join(", ") else "a reviewer" end)"
       elif .reviewDecision == "REVIEW_REQUIRED" then
         "  ○ Waiting for a review\([(.reviewRequests // [])[] | (.login // .name // empty)] | if length > 0 then " from " + join(", ") else "" end)"
       else empty end),
      (if .mergeable == "CONFLICTING" then "  ✗ Conflicts with \(.baseRefName)" else empty end),
      (if .isDraft then "  ○ It is still a draft" else empty end)'
}

# merge_when (the same JSON): what has to happen first, as one clause
merge_when() {
  jq -r '
    def bad: (.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE");
    def and_list: if length <= 1 then (.[0] // "") else (.[:-1] | join(", ")) + " and " + .[-1] end;
    (.statusCheckRollup // []) as $c | ([$c[] | select(bad)] | length) as $f
    | ([$c[] | select(((.status // "COMPLETED") != "COMPLETED") or ((.state // "") | test("PENDING|EXPECTED")))] | length) as $p
    | [(.reviewRequests // [])[] | (.login // .name // empty)] as $who
    | [ (if $f == 1 then "the check passes" elif $f > 1 then "the checks pass" elif $p > 0 then "the running checks pass" else empty end),
        (if .reviewDecision == "REVIEW_REQUIRED" then (if ($who | length) > 0 then ($who | and_list) + (if ($who | length) == 1 then " approves" else " approve" end) else "it is approved" end)
         elif .reviewDecision == "CHANGES_REQUESTED" then "the requested changes are approved" else empty end),
        (if .mergeable == "CONFLICTING" then "the conflicts are fixed" else empty end),
        (if .isDraft then "it is marked ready" else empty end) ]
    | if length == 0 then "it is ready" else and_list end'
}

tool_pr_merge() {
  local how auto del out
  how=$(arg method); how=${how:-squash} auto=$(arg auto) del=$(arg delete_branch)
  case $how in squash | merge | rebase) ;; *) echo "method is squash, merge or rebase"; return 1 ;; esac
  parse_pr "$(arg pr)" || return 1
  use_account "$(arg account)" || return 1
  local j
  j=$(timeout 30 gh pr view "$N" -R "$REPO" --json title,state,isDraft,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup,headRefName,baseRefName,commits,url,additions,deletions,changedFiles,reviewRequests,latestReviews 2>&1) \
    || { echo "gh pr view: ${j:0:300}"; return 1; }
  # what lands, and what follows: stacked PRs on this branch move to its base
  local label title head base stacked nready=0 facts chips frame why_not="" failed_url
  case $how in squash) label="squash" ;; merge) label="merge commit" ;; *) label="rebase" ;; esac
  title=$(jq -r .title <<<"$j") head=$(jq -r .headRefName <<<"$j") base=$(jq -r .baseRefName <<<"$j")
  local ncommits method lands nstacked
  ncommits=$(jq -r '.commits | length' <<<"$j")
  case $how in
    squash) method="squash, $(count "$ncommits" commit) into 1" lands="one new commit" ;;
    merge) method="merge commit, $(count "$ncommits" commit)" lands="$(count "$ncommits" commit) and a merge commit" ;;
    *) method="rebase, $(count "$ncommits" commit)" lands="$(count "$ncommits" "new commit")" ;;
  esac
  stacked=$(timeout 30 gh pr list -R "$REPO" --base "$head" --json number --jq 'map("#\(.number)") | join(", ")' 2>/dev/null)
  # each thing a merge needs: ok, no or wait, then what it says
  local checks review conflicts
  checks=$(jq -r '(.statusCheckRollup // []) as $c | ($c | length) as $n
    | [$c[] | select((.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE"))] as $f
    | [$c[] | select(((.status // "COMPLETED") != "COMPLETED") or ((.state // "") | test("PENDING|EXPECTED")))] as $p
    | if $n == 0 then "none\tChecks: none"
      elif ($f | length) > 0 then "no\tChecks: \($f | length) failed, \($n - ($f | length) - ($p | length)) passed"
      elif ($p | length) > 0 then "wait\tChecks: \($p | length) running, \($n - ($p | length)) passed"
      else "ok\tChecks: \($n) of \($n) passed" end' <<<"$j")
  review=$(jq -r '[(.latestReviews // [])[] | select(.state == "APPROVED") | .author.login] as $by
    | if .reviewDecision == "APPROVED" then "ok\tReview: approved\(if ($by | length) > 0 then " by " + ($by | join(", ")) else "" end)"
    elif .reviewDecision == "CHANGES_REQUESTED" then "no\tReview: changes requested"
    elif .reviewDecision == "REVIEW_REQUIRED" then "wait\tReview: needs an approval"
    else "none\tReview: none required" end' <<<"$j")
  conflicts=$(jq -r 'if .mergeable == "MERGEABLE" then "ok\tNo conflicts"
    elif .mergeable == "CONFLICTING" then "no\tHas conflicts" else "wait\tChecking for conflicts" end' <<<"$j")
  local one
  for one in "$checks" "$review" "$conflicts"; do case ${one%%$'\t'*} in no | wait) nready=$((nready + 1)) ;; esac; done
  [ "$(jq -r .isDraft <<<"$j")" = true ] && nready=$((nready + 1))
  why_not=$(jq -r '
    def bad: (.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE");
    ([(.statusCheckRollup // [])[] | select(bad)] | length) as $f
    | if $f > 0 then "\($f) check\(if $f == 1 then "" else "s" end) failed"
      elif .mergeable == "CONFLICTING" then "has conflicts"
      elif .reviewDecision == "CHANGES_REQUESTED" then "changes requested"
      elif .reviewDecision == "REVIEW_REQUIRED" then "needs a review"
      elif .isDraft then "a draft"
      else "checks still running" end' <<<"$j")
  facts=$(printf 'H\t%s\n' "$( ((nready)) && echo "Not ready yet" || echo "Ready to merge")"
    for one in "$checks" "$review" "$conflicts"; do
      case ${one%%$'\t'*} in ok) printf 'F\t✓\t%s\n' "${one#*$'\t'}" ;; no) printf 'F\t✗\t%s\n' "${one#*$'\t'}" ;; wait) printf 'F\t○\t%s\n' "${one#*$'\t'}" ;; *) printf 'F\t·\t%s\n' "${one#*$'\t'}" ;; esac
    done
    printf 'H\t \nH\tThe merge\n'
    printf 'F\tFrom\t%s\nF\tInto\t%s\nF\tMethod\t%s\nF\tAs\t%s\n' "$head" "$base" "$method" "$ACCT"
    jq -r '"F\tSize\t+\(.additions) -\(.deletions) in \(.changedFiles) files"' <<<"$j")
  chips=""
  ((nready)) && chips+="bad"$'\t'"not ready: $why_not"$'\n'
  [ "$auto" = true ] && chips+="warn"$'\t'"merges later, without asking again"$'\n'
  chips+="bad"$'\t'"lands on $base"
  chips+=$'\n'"plain"$'\t'"undo is a revert"
  [ "$del" = true ] && chips+=$'\n'"plain"$'\t'"deletes the branch"
  nstacked=$(tr ',' '\n' <<<"$stacked" | grep -c '#')
  [ -n "$stacked" ] && chips+=$'\n'"plain"$'\t'"moves $(count "$nstacked" "stacked PR")"
  frame=$(printf 'Commits that land\n'
    jq -r '.commits | length as $n | (.[:12][] | "  \(.oid[0:7])  \(.messageHeadline)"), (if $n > 12 then "  … \($n - 12) more" else empty end)' <<<"$j"
    if ((nready)); then
      printf '\nWhat'"'"'s stopping it\n'
      merge_blockers <<<"$j"
    fi
    if [ "$auto" = true ]; then
      printf '\nWhat happens if you approve\n'
      if ((nready)); then printf '  Nothing changes now. When %s, GitHub merges it into %s without another question.\n' "$(merge_when <<<"$j")" "$base"
      else printf '  It is ready, so GitHub merges it into %s in a moment, without another question.\n' "$base"; fi
    else
      printf '\nWhat happens next\n  1. %s gets %s\n' "$base" "$lands"
      local step=2
      [ "$del" = true ] && { printf '  %d. %s is deleted\n' "$step" "$head"; step=$((step + 1)); }
      [ -n "$stacked" ] && printf '  %d. %s retarget%s to %s\n' "$step" "$stacked" "$( ((nstacked == 1)) && echo s)" "$base"
    fi)
  failed_url=$(jq -r '[(.statusCheckRollup // [])[] | select((.conclusion // .state // "") | test("FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE")) | (.detailsUrl // .targetUrl // empty)][0] // empty' <<<"$j")
  local say target after action
  if [ "$auto" = true ]; then say="merge into" target=$base after=" by itself, once it's ready" action="Turn on auto-merge"
  else
    case $how in squash) say="squash and merge into" ;; rebase) say="rebase and merge into" ;; *) say="merge into" ;; esac
    target=$base after="" action="Merge into $base"
  fi
  ASK_WHY=$(arg why) ASK_KIND=$([ "$auto" = true ] && echo Auto-merge || echo Merge) ASK_REF="$REPO#$N" ASK_TONE=danger ASK_SAY=$say ASK_TARGET=$target ASK_AFTER=$after ASK_ACTION=$action \
    ASK_TITLE=$title ASK_CHIPS=$chips ASK_FACTS=$facts ASK_FRAME=$frame ASK_URL=$(jq -r .url <<<"$j") ASK_LOG=$failed_url \
    ASK_DIFF=$(timeout 20 gh pr diff "$N" -R "$REPO" --color=never 2>/dev/null) \
    asked "$([ "$auto" = true ] && echo "turn on auto-merge ($label) for" || echo "merge ($label)") $REPO#$N" \
    "$title"$'\n'"$head → $base"$'\n'"as $ACCT$([ "$del" = true ] && echo ", then delete the branch")" || return 1
  # From /: with --delete-branch, gh would also switch and delete branches
  # of a local clone it runs in.
  local flags=("--$how")
  [ "$auto" = true ] && flags+=(--auto)
  [ "$del" = true ] && flags+=(--delete-branch)
  out=$(cd / && timeout 120 gh pr merge "$N" -R "$REPO" "${flags[@]}" </dev/null 2>&1) || { echo "gh pr merge failed: $out"; return 1; }
  changed
  if [ "$auto" = true ]; then echo "Auto-merge ($how) is on for $REPO#$N: it merges once everything passes."
  else echo "Merged $REPO#$N ($how) as $ACCT.${out:+ $out}"; fi
}

run_tool() {  # run_tool <name>, with its arguments (a JSON object) in $ARGS
  case $1 in
    pr_accounts | pr_counts | pr_list | pr_view | pr_diff | pr_comment | pr_review | pr_merge) "tool_$1" ;;
    *) echo "unknown tool \"$1\" (sangam call lists them)"; return 1 ;;
  esac
}

# sangam call <tool> [json]: one tool, for agents without MCP. Exit 1 on error.
agent_call() {
  check_agent_deps || exit 1
  if [ -z "${1:-}" ]; then
    printf 'sangam call <tool> [json arguments]   e.g.  sangam call pr_view %s\n\n' "'{\"pr\":\"owner/repo#12\"}'"
    jq -r '.[] | "  \(.name)\n      \(.description)\n      arguments: \(.inputSchema.properties | keys | join(", ") | if . == "" then "none" else . end)"' <<<"$TOOLS_JSON"
    exit 0
  fi
  ARGS=${2:-'{}'}
  jq -e 'type == "object"' <<<"$ARGS" >/dev/null 2>&1 || die "the arguments must be a JSON object, like '{\"pr\":\"owner/repo#12\"}'"
  run_tool "$1"
}

check_agent_deps() {
  local c; for c in gh jq; do command -v "$c" >/dev/null || { echo "sangam: $c is needed (sangam doctor)" >&2; return 1; }; done
}

# sangam mcp: an MCP server (JSON-RPC, one message per line, on stdio).
# Each tool call runs in the background, so a call waiting for your
# approval doesn't hold up the others; replies are written one at a time.
mcp_server() {
  check_agent_deps || exit 1
  local line id method
  MCP_LOCK=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/sangam-mcp.XXXXXX") || exit 1
  trap 'rm -f "$MCP_LOCK"' EXIT
  reply() { { flock 9; printf '%s\n' "$1"; } 9>>"$MCP_LOCK"; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id=$(jq -c '.id // empty' <<<"$line" 2>/dev/null) method=$(jq -r '.method // empty' <<<"$line" 2>/dev/null)
    case $method in
      initialize)
        ASK_WHO=$(jq -r '.params.clientInfo.name // empty' <<<"$line" 2>/dev/null)
        case ${ASK_WHO,,} in claude-code | claude*code) ASK_WHO="Claude Code" ;; codex*) ASK_WHO="Codex" ;; gemini*) ASK_WHO="Gemini" ;; opencode*) ASK_WHO="opencode" ;; esac
        export ASK_WHO
        reply "$(jq -cn --argjson id "$id" --arg v "$(jq -r '.params.protocolVersion // "2025-06-18"' <<<"$line")" \
          --arg ver "$VERSION" --arg ins "$MCP_INSTRUCTIONS" \
          '{jsonrpc: "2.0", id: $id, result: {protocolVersion: $v, capabilities: {tools: {}},
            serverInfo: {name: "sangam", version: $ver}, instructions: $ins}}')" ;;
      ping) reply "$(jq -cn --argjson id "$id" '{jsonrpc: "2.0", id: $id, result: {}}')" ;;
      tools/list) reply "$(jq -cn --argjson id "$id" --argjson t "$TOOLS_JSON" '{jsonrpc: "2.0", id: $id, result: {tools: $t}}')" ;;
      tools/call)
        (
          ARGS=$(jq -c '.params.arguments // {}' <<<"$line") name=$(jq -r '.params.name' <<<"$line")
          # a fresh sangam each call: a server started before an update still
          # runs the current code (and the current popup)
          err=$(mktemp) out=$(ARGS=$ARGS "$self" --mcp-tool "$name" 2>"$err"); rc=$?
          ((rc)) && [ -s "$err" ] && out+=$'\n'$(tail -c 2000 "$err")
          rm -f "$err"
          reply "$(jq -cn --argjson id "$id" --arg t "$out" --argjson e "$([ $rc = 0 ] && echo false || echo true)" \
            '{jsonrpc: "2.0", id: $id, result: {content: [{type: "text", text: $t}], isError: $e}}')"
        ) & ;;
      *) [ -n "$id" ] && reply "$(jq -cn --argjson id "$id" --arg m "$method" '{jsonrpc: "2.0", id: $id, error: {code: -32601, message: ("no method " + $m)}}')" ;;
    esac
  done
  wait
}

# ------------------------------------------------------------------ main
case $1 in
  --list) list "$2"; exit ;;
  --reload) fetch_list; changed; list; exit ;;
  --preview) [ -n "$2" ] && { set_pr "$2" || exit; }; preview "$N"; exit ;;
  --plabel) preview_label "$2"; exit ;;
  --llabel) list_label "$2"; exit ;;
  --colhead) colhead; exit ;;
  --keys) keysheet; exit ;;
  --sections-menu) sections_menu; exit ;;
  --strip) strip; exit ;;
  --main) run_main; exit ;;
  --show-keys)
    tmux display-popup -E -w 116 -h 15 -b rounded -S "fg=$HI" -T "#[fg=$HI] keys #[fg=$DIMH]· any key closes " \
      "STATE='$STATE' '$self' --keys"; exit ;;
  --toggle-all)
    if [ "$(state)" = all ]; then echo open >"$STATE/state"; else echo all >"$STATE/state"; fi
    rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --next-acct)
    mapfile -t accts <"$STATE/accounts"
    cur=$(acct) nxt=""
    if [ -z "$cur" ]; then nxt=${accts[0]:-}
    else for i in "${!accts[@]}"; do [ "${accts[$i],,}" = "${cur,,}" ] && nxt=${accts[$((i + 1))]:-}; done; fi
    printf '%s' "$nxt" >"$STATE/acct"; printf '%s' "$nxt" >"$CROOT/last-account"; build_sections; echo 0 >"$STATE/sec"; rm -f "$STATE/fresh" "$STATE/query"
    setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --search)
    clear; printf '\n  %sSearch GitHub within %s%s%s\n  %se.g.  author:jiggy   label:bug   head:feat/x   "matchmaking"   (empty clears)%s\n\n  %s❯%s ' \
      "$dim" "$gold" "$(secf "$(sec)" 1)" "$r" "$dim" "$r" "$rose" "$r"
    read -re -i "$(query)" q || exit
    printf '%s' "$q" >"$STATE/query"; rm -f "$STATE/fresh"; exit ;;
  --mode) echo "$2" >"$STATE/mode"; exit ;;
  --next-mode)
    case $(mode) in overview) m='diff' ;; diff) m='checks' ;; checks) m='comments' ;; *) m='overview' ;; esac
    echo "$m" >"$STATE/mode"; exit ;;
  --next-state)
    cur=$(state) nxt=${STATES[0]}
    for i in "${!STATES[@]}"; do [ "${STATES[$i]}" = "$cur" ] && nxt=${STATES[$(( (i + 1) % ${#STATES[@]} ))]}; done
    echo "$nxt" >"$STATE/state"; rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --section)
    echo $(( ($(sec) + $2 + $(nsec)) % $(nsec) )) >"$STATE/sec"; rm -f "$STATE/fresh"
    secf "$(sec)" 1 >"$CROOT/last-section"; exit ;;
  --edit)
    [ -f "$CONFIG" ] || default_config
    "${VISUAL:-${EDITOR:-vi}}" "$CONFIG" </dev/tty >/dev/tty
    build_sections; rm -f "$STATE/fresh"; setsid -f "$self" --fetch-all >/dev/null 2>&1; exit ;;
  --fetch-all) fetch_all; exit ;;
  --fetch-pr) set_pr "$2" && fetch_pr "$N"; exit ;;
  # First load shows the cached list; it then asks for the fresh one once.
  # Every load updates the tabs and prefetches details in the background.
  --on-load)
    if [ ! -e "$STATE/fresh" ]; then
      touch "$STATE/fresh"; echo "change-list-label($(list_label refreshing…))+reload-sync($self --reload)"; exit
    fi
    setsid -f "$self" --prefetch >/dev/null 2>&1
    echo "change-list-label($(list_label))"; exit ;;
  --copy)
    set_pr "$2" && jq -r .url "$CACHE/$N.json" 2>/dev/null | clip && notify "$N" "Link copied"
    exit ;;
  --web) set_pr "$2" && gh pr view "$N" -R "$REPO" --web >/dev/null 2>&1; exit ;;
  --prefetch) prefetch; exit ;;
  --action) set_pr "$3" && action "$2" "$N"; exit ;;
  --full) set_pr "$2" && open_full "$N"; exit ;;
  --approve-ui) approve_ui; exit ;;
  --mcp-tool) check_agent_deps || exit 1; run_tool "$2"; exit ;;
esac

# ------------------------------------------------------------------ CLI
popup=""
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help) usage; exit 0 ;;
    -V | --version) echo "sangam $VERSION"; exit 0 ;;
    doctor) doctor; exit ;;
    mcp) mcp_server; exit ;;
    call) shift; agent_call "$@"; exit ;;
    -C) [ -n "$2" ] || die "-C needs a directory"; cd "$2" || exit 1; shift 2 ;;
    --popup) popup=${2:-G}; shift 2 ;;
    --session) shift ;;   # tmux-gh-pr's old entry point
    *) printf 'sangam: unknown option %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
open_session "$popup"
